# NODE_ENV is development, test, or production.
# npm run start:dev sets development when it is unset. Jest and Playwright set test.
# Production startup checks run only when NODE_ENV=production.
# NODE_ENV=development

# Prisma Client uses DATABASE_URL. Required for the API process, including production startup.
# Prisma Migrate uses DIRECT_URL. DIRECT_URL is not required for the API process to start.
# Locally both point at the same PostgreSQL database. There is no pooler.
# In production, DATABASE_URL is the Neon pooled URL and DIRECT_URL is the Neon direct URL.
# Leave real Neon values out of this file.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub"

# Required in every environment. At least 32 characters.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave this blank in the example. Do not commit a real secret.
JWT_SECRET=

# Comma-separated browser origins (scheme, host, and optional port). No paths and no "*".
# Required in production. When unset outside production, the API allows http://localhost:5173.
# CORS and POST /auth/login use this same list.
AUTH_ORIGINS=http://localhost:5173

# Optional. Defaults are 5 failed logins per normalized email and 100 per IP in a 15-minute fixed window.
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=100

# Production behind the trusted reverse proxy must set exactly TRUST_PROXY=true.
# Any other value does not enable Express trust proxy. Omit this locally.
# TRUST_PROXY=true

# Resend is server-side only. Never put the key in frontend code or commit a real value.
# Leave RESEND_API_KEY blank to keep the local development terminal outbox on operations_hub.
# Production startup requires RESEND_API_KEY and EMAIL_FROM together.
RESEND_API_KEY=
EMAIL_FROM=Internal Operations Service Hub <onboarding@resend.dev>

# Production startup requires AI_PROVIDER=requesty plus REQUESTY_API_KEY and REQUESTY_MODEL.
# Tests force AI_PROVIDER=mock and do not need the Requesty values.
AI_PROVIDER=requesty
REQUESTY_API_KEY=
REQUESTY_MODEL=mistral/leanstral-1-5

# Optional. Render sets PORT. The API listens on 3000 when PORT is unset.
# PORT=3000
