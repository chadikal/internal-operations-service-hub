# Prisma Client uses DATABASE_URL. Prisma Migrate uses DIRECT_URL.
# Locally both point at the same PostgreSQL database. There is no pooler.
# In production, DATABASE_URL is the Neon pooled URL and DIRECT_URL is the Neon direct URL.
# Leave real Neon values out of this file.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub"

# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave this blank in the example. Do not commit a real secret.
JWT_SECRET=

# Comma-separated origins allowed to call POST /auth/login. Separate from CORS, which uses the same list.
AUTH_ORIGINS=http://localhost:5173

# Optional. Defaults are 5 failed logins per normalized email and 100 per IP in a 15-minute fixed window.
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=100

# Set to true only when a trusted reverse proxy overwrites X-Forwarded-For. Otherwise the API uses the socket address.
# TRUST_PROXY=true

# Resend is server-side only. Never put the key in frontend code or commit a real value.
# Leave RESEND_API_KEY blank to keep the local development terminal outbox on operations_hub.
# Both values are required before production signup, invitations, or password reset can send mail.
RESEND_API_KEY=
EMAIL_FROM=Internal Operations Service Hub <onboarding@resend.dev>

AI_PROVIDER=requesty
REQUESTY_API_KEY=
REQUESTY_MODEL=mistral/leanstral-1-5
