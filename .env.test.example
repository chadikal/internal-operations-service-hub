# Copy this file to .env.test and set your local Postgres password.
# Automated tests and npm run test:db:setup load .env.test only.
# They will not fall back to .env or the operations_hub development database.
# Jest and Playwright set NODE_ENV=test. Production startup checks do not run.
# Jest and Playwright set a test-only JWT_SECRET and AUTH_ORIGINS=http://localhost:5173. Do not put a real secret here.
# Playwright also sets TEST_EMAIL_OUTBOX for the API process. There is no HTTP token route.
# Do not set production-only values here: RESEND_API_KEY, EMAIL_FROM, REQUESTY_API_KEY, REQUESTY_MODEL, TRUST_PROXY.
# Jest removes Resend settings, and automated tests must not send real email or call Requesty.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub_test"
# Test scripts set DIRECT_URL to this same operations_hub_test URL. Do not point tests at Neon.
# DIRECT_URL is for Prisma migrations, not API startup.
AI_PROVIDER=mock

