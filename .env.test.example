# Copy this file to .env.test and set your local Postgres password.
# Automated tests and npm run test:db:setup load .env.test only.
# They will not fall back to .env or the operations_hub development database.
# Jest and Playwright set a test-only JWT_SECRET themselves. Do not put a real secret here.
# Playwright sets NODE_ENV=test and TEST_EMAIL_OUTBOX for the API process. There is no HTTP token route.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/operations_hub_test"
AI_PROVIDER=mock

