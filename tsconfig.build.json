{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "frontend",
    "prisma",
    "e2e",
    "playwright.config.ts",
    "**/*.spec.ts",
    "src/jest.setup.ts",
    "src/requests/test-helpers.ts"
  ]
}
